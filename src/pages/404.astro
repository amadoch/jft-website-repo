---
import Layout from "../layouts/layout.astro";
---

<Layout>
  <div class="h-[38dvh]">
    <div class="mx-auto flex flex-col flex-nowrap justify-center items-center gap-5">
      <h1 class="text-pinkish text-5xl">Página no econtrada</h1>
      <p class="text-roast">
        La dirección que acabas de ingresar no dirige a ninguna parte del sitio
        web...
      </p>
      <a
        href="/"
        class="py-1 md:py-2 px-3 md:px-6 bg-pinkish hover:bg-roast text-mocha-light"
      >
        Volver a la página principal
      </a>
    </div>
  </div>
</Layout>
